{
  "name": "phaser-editor",
  "version": "0.1.0",
  "private": true,
  "author": "Dilaver Serif Karakadioglu",
  "description": "Electron tabanli, Phaser Editor 2D uyumlu Phaser 4 sahne + prefab editoru",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/fix-electron.cjs",
    "fix:electron": "node scripts/fix-electron.cjs",
    "dev": "node scripts/fix-electron.cjs && vite",
    "electron:dev": "node scripts/fix-electron.cjs && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "phaser": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.example.phaser-editor",
    "productName": "Phaser Editor",
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
